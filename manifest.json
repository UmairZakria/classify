{
  "manifest_version": 3,
  "name": "Lead Row Copier",
  "version": "1.0.0",
  "description": "Classify lead notes and copy a Google Sheets row from the comments text area.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/Poppins-Light.ttf"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Made By Umair Zakria"
  }
}
